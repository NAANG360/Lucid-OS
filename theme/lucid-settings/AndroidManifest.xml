<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.lucid.os.settings">
    <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <application android:label="Lucid Settings" android:theme="@android:style/Theme.Material.NoActionBar" android:allowBackup="false">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity>
            <provider android:name=".AppearanceProvider" android:authorities="com.lucid.os.settings.appearance" android:exported="true" android:grantUriPermissions="false" />
    </application>
</manifest>