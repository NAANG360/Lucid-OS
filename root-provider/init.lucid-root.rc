# Lucid Root broker. The service is intentionally not started until the
# matching compiled SELinux policy and binaries are included in the ROM.
on post-fs-data
    mkdir /data/misc/lucid-root 0700 root root
    restorecon_recursive /data/misc/lucid-root

service lucid_rootd /system/bin/lucid_rootd
    class core
    user root
    group root
    socket lucid-root stream 0660 root system
    disabled
    oneshot

on property:sys.boot_completed=1
    start lucid_rootd
