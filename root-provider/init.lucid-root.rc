# Lucid Root broker. Do not add an init-created socket: lucid_rootd binds it.
on post-fs-data
    mkdir /data/misc/lucid-root 0700 root root
    restorecon_recursive /data/misc/lucid-root
    mkdir /dev/socket 0755 root root

service lucid_rootd /system/bin/lucid_rootd
    class core
    user root
    group root
    disabled
    oneshot

on property:sys.boot_completed=1
    start lucid_rootd
