# Lucid Desktop is fail-closed until the scoped chroot privilege backend is integrated.
# The current service still runs as Android-host root; a chroot is not a security boundary.
# Do not set persist.lucid.chroot_backend_ready in a release without the dedicated
# SELinux domain, validated helper, and Developer Options control described in
# docs/CHROOT_PRIVILEGE_BOUNDARY.md.
service lucid_desktop /system/bin/lucid_desktop.sh
    class main
    user root
    group root
    seclabel u:r:su:s0
    disabled
    oneshot

# Both gates are required. backend_ready intentionally has no default-on value.
on property:sys.lucid.casting=1 && property:persist.lucid.chroot_root=1 && property:persist.lucid.chroot_backend_ready=1
    start lucid_desktop

# Root-off is fail-closed: stop the session and reset its local ADB bridge.
on property:persist.lucid.chroot_root=0
    stop lucid_desktop
    setprop service.adb.tcp.port -1
    stop adbd
    start adbd

on property:persist.lucid.chroot_backend_ready=0
    stop lucid_desktop
    setprop service.adb.tcp.port -1
    stop adbd
    start adbd

on property:sys.lucid.casting=0
    stop lucid_desktop
    setprop service.adb.tcp.port -1
    stop adbd
    start adbd

on property:sys.boot_completed=1
    exec u:r:su:s0 root root -- /system/bin/lucid_firstboot.sh
