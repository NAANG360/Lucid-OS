# Define the chroot daemon
service lucid_desktop /system/bin/lucid_desktop.sh
    class main
    user root
    group root
    seclabel u:r:su:s0
    disabled
    oneshot

# Desktop/casting is independent of root availability. A display toggle must
# never chmod the su binary or silently grant/revoke device-wide root.
on property:sys.lucid.casting=1
    start lucid_desktop

# Stop the chroot desktop and return the local ADB bridge to its default state.
on property:sys.lucid.casting=0
    stop lucid_desktop
    setprop service.adb.tcp.port -1
    stop adbd
    start adbd

# LucidOS first-boot setup
on property:sys.boot_completed=1
    exec u:r:su:s0 root root -- /system/bin/lucid_firstboot.sh
